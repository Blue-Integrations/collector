# Copy to .env and fill in real values.
#   cp .env.example .env

# --- Portal ---
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8080
PORTAL_USER=admin
PORTAL_PASSWORD=changeme
SECRET_KEY=replace-with-a-long-random-string
# SECRET_KEY is also the API key for /api/dump (X-API-Key or ?key=)

# --- NetFlow probe ---
NETFLOW_HOST=0.0.0.0
NETFLOW_PORT=2055

# --- MikroTik SSH ---
MIKROTIK_HOST=192.168.88.3
MIKROTIK_PORT=22232
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
# Optional: path to an OpenSSH private key instead of (or in addition to) a password
MIKROTIK_KEY_PATH=
MIKROTIK_ADDRESS_LIST=blocked-scanners
MIKROTIK_BLOCK_TIMEOUT=1d

# Which SSH blocker the portal uses (also a radio on the dashboard).
BLOCKER_VENDOR=mikrotik

# --- Cisco IOS / IOS-XE SSH (when BLOCKER_VENDOR=cisco) ---
CISCO_HOST=
CISCO_PORT=22
CISCO_USER=admin
CISCO_PASSWORD=
CISCO_KEY_PATH=
CISCO_ENABLE_PASSWORD=
CISCO_ACL=NETFLOW-COLLECTOR
CISCO_OBJECT_GROUP=blocked-scanners

# --- Juniper Junos SSH (when BLOCKER_VENDOR=juniper) ---
JUNIPER_HOST=
JUNIPER_PORT=22
JUNIPER_USER=admin
JUNIPER_PASSWORD=
JUNIPER_KEY_PATH=
JUNIPER_PREFIX_LIST=blocked-scanners
JUNIPER_FILTER=NETFLOW-COLLECTOR

# Start in detect-only mode. Flip to true (or use the portal toggle) to push blocks.
AUTO_BLOCK=false

# Never auto-block these CIDRs (LAN, the collector, management).
# Public DNS (1.1.1.1, 8.8.8.8, 9.9.9.9, OpenDNS) is always ignored in code.
ALLOWLIST=192.168.88.0/24,127.0.0.0/8
PROTECTED_CIDRS=151.244.12.0/27

# Scan detector
SCAN_WINDOW_SEC=30
VERTICAL_PORT_THRESHOLD=40
HORIZONTAL_HOST_THRESHOLD=40
UNIQUE_PORT_THRESHOLD=80
ICMP_FLOOD_THRESHOLD=50
LARGE_FLOW_MIN_BYTES=2048
LARGE_FLOW_THRESHOLD=20

# Chat webhooks (optional — also editable under portal Webhooks)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_NOTIFY_DETECTIONS=true
WEBHOOK_NOTIFY_BLOCKS=true

# Generate synthetic scans so you can exercise the UI without live NetFlow
DEMO=false

# --- Database ---
# sqlite = single-file lab / small installs (default)
# mysql = shared DB for heavier or multi-host deployments
DB_ENGINE=sqlite
DB_PATH=data/collector.db

# MySQL (when DB_ENGINE=mysql). Create the database and user first, e.g.:
#   CREATE DATABASE collector CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'collector'@'%' IDENTIFIED BY 'your-password';
#   GRANT ALL PRIVILEGES ON collector.* TO 'collector'@'%';
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=-C
MYSQL_DATABASE=

# Self-upgrade (git checkout + pip install -e .)
# CLI: cd /path/to/collector && source .venv/bin/activate && python3 -m collector upgrade
# DB migrate (SQLite → MySQL): python3 -m collector db migrate --dry-run
UPGRADE_GIT_REMOTE=origin
UPGRADE_GIT_BRANCH=
UPGRADE_RESTART_CMD=
UPGRADE_ALLOW_API=true
